rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: authenticated users can read all, write only own document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Tickets: authenticated users can read and write
    match /tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }

    // Customers: authenticated users can read, admins can write
    match /customers/{customerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Comments: authenticated users can read and create
    match /comments/{commentId} {
      allow read, write: if request.auth != null;
    }

    // Logs: authenticated users can read and create
    match /logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Settings: authenticated users can read, write for ticket counter
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }
  }
}
